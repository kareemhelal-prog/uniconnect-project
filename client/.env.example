# Google OAuth — get this from Google Cloud Console (OAuth 2.0 Client ID, type "Web application")
# This is the SAME Client ID used by the server.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Deployed backend API base URL (must end with /api). Leave EMPTY in local dev so
# the Vite proxy forwards /api to the local backend. In production (Vercel) set it
# to your deployed backend, e.g. https://your-backend.up.railway.app/api
VITE_API_URL=
