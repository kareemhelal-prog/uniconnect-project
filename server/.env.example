# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=uniconnect
DB_PORT=3306

# ── JWT ───────────────────────────────────────
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=7d

# ── Email (Gmail app password) ────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ── Google OAuth ──────────────────────────────
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console.
# The Client ID must match client/.env VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Deployment (production) ───────────────────
# PORT is provided automatically by the host (Railway/Render) — leave unset locally.
# CORS_ORIGINS: comma-separated frontend URLs allowed to call the API. Leave EMPTY
# in local dev (permissive); in production set it to your deployed frontend URL:
CORS_ORIGINS=https://uni-km-connect.vercel.app
